{% extends "base.html.twig" %}

{% block body %}
    {{ parent() }}
	<h1 id="post-https-your_domain-cleanly-v1-webhook">POST https://<code>&lt;your_domain&gt;</code>/cleanly/v1/webhook</h1>
<p>This endpoint will be called when a task was completed in a registered household. You can register a webhook for your household in your household settings.</p>
<h2 id="authentication">Authentication</h2>
<p>You will receive the <code>AuthToken</code> when registering <code>&lt;your_domain&gt;</code> in the household settings.</p>
<pre><code><span class="hljs-symbol">Authorization:</span> Bearer <span class="hljs-params">&lt;AuthToken&gt;</span>
</code></pre><h2 id="body-data">Body Data</h2>
<table class="table">
<thead>
<tr>
<th>key</th>
<th>type</th>
</tr>
</thead>
<tbody>
<tr>
<td>action</td>
<td>&quot;task_done&quot;</td>
</tr>
<tr>
<td>household</td>
<td>Household</td>
</tr>
<tr>
<td>task</td>
<td>Task</td>
</tr>
<tr>
<td>done_by</td>
<td>User</td>
</tr>
</tbody>
</table>
