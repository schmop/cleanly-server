{% extends "base.html.twig" %}

{% block title %} Changelogs - Cleanly {% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        img {
            border-radius: 4px;
            box-shadow: 0px 0px 3px 0px white;
            max-width: 100%;
            margin: 8px 0;
        }
    </style>
{% endblock %}

{% block body %}
    {{ parent() }}
    {{ content | raw }}
{% endblock %}